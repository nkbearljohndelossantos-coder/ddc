# ==============================================================================
# NKB Enterprise Document Scanning Platform - Environment Variables Template
# ==============================================================================

# Server Environment
NODE_ENV=development
PORT=4000
REALTIME_PORT=4001
API_URL=http://localhost:4000
FRONTEND_URL=http://localhost:5173

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=nkb_user
DB_PASSWORD=nkb_development_secret_password_change_in_prod
DB_NAME=nkb_scanner_db
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?schema=public

# Redis Broker & Job Queues
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=nkb_redis_dev_secret_change_in_prod

# JWT Authentication
JWT_SECRET=nkb_super_secret_jwt_access_key_min_32_chars_long_12345
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=nkb_super_secret_jwt_refresh_key_min_32_chars_long_67890
JWT_REFRESH_EXPIRES_IN=7d

# S3 / MinIO Object Storage
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=nkb_minio_admin_dev
S3_SECRET_KEY=nkb_minio_secret_key_change_in_prod
S3_REGION=us-east-1
S3_BUCKET_DOCS=nkb-documents
S3_BUCKET_QUARANTINE=nkb-quarantine
S3_USE_SSL=false

# Scanner Agent Configuration
AGENT_REGISTRATION_ENABLED=true
AGENT_TOKEN_TTL_MINUTES=15
AGENT_HEARTBEAT_INTERVAL_SECONDS=10
AGENT_OFFLINE_THRESHOLD_SECONDS=30

# Logging & Monitoring
LOG_LEVEL=debug
ENABLE_METRICS=true
METRICS_PORT=9090
