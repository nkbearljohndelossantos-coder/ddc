# ==========================================
# DCC ENTERPRISE PLATFORM - PRODUCTION ENVIRONMENT CONFIGURATION
# ==========================================
# IMPORTANT: All passwords and secrets below are place-holders and MUST be generated
# with high-entropy cryptographic random generators before deployment.

NODE_ENV=production
PORT=3000
INSTANCE_ID=api-node-01
FRONTEND_URL=https://dcc.enterprise.corp

# 1. DATABASE CONFIGURATION (PostgreSQL 16+)
DATABASE_URL=postgresql://dcc_admin:REPLACE_WITH_STRONG_DB_PASSWORD@postgres:5432/dcc_production?schema=public&connection_limit=50&pool_timeout=20

# 2. SHARED REDIS CLUSTER (Redis 7+)
REDIS_URL=redis://:REPLACE_WITH_STRONG_REDIS_PASSWORD@redis:6379

# 3. AUTHENTICATION & JWT SECRETS (Min 32 bytes high entropy)
JWT_SECRET=REPLACE_WITH_RANDOM_HEX_64_CHARACTERS_FOR_ACCESS_TOKENS
JWT_REFRESH_SECRET=REPLACE_WITH_RANDOM_HEX_64_CHARACTERS_FOR_REFRESH_TOKENS
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# 4. OBJECT STORAGE PROVIDER (S3, MinIO, Cloudflare R2, or LOCAL)
STORAGE_PROVIDER=S3
S3_ENDPOINT=https://s3.enterprise.corp
S3_REGION=us-east-1
S3_BUCKET=dcc-documents
S3_ACCESS_KEY=REPLACE_WITH_S3_ACCESS_KEY
S3_SECRET_KEY=REPLACE_WITH_S3_SECRET_KEY
STORAGE_BASE_DIR=/var/dcc/storage

# 5. DISASTER RECOVERY & RPO/RTO TARGETS
DR_RPO_TARGET_MINUTES=60
DR_RTO_TARGET_MINUTES=30
BACKUP_DESTINATION_PATH=/var/dcc/backups

# 6. EXTERNAL NOTIFICATIONS & SMTP RELAY
SMTP_HOST=smtp.enterprise.corp
SMTP_PORT=587
SMTP_SECURE=true
SMTP_USER=dcc-notifications@enterprise.corp
SMTP_PASS=REPLACE_WITH_SMTP_PASSWORD
NOTIFICATION_FROM_ADDRESS=dcc-notifications@enterprise.corp

# 7. TELEMETRY & OBSERVABILITY
LOG_LEVEL=info
ENABLE_METRICS=true
METRICS_PORT=9090
