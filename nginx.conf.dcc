server {
    listen 80;
    server_name dcc.nkbmanufacturing.com;

    # Redirect all HTTP requests to HTTPS
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    server_name dcc.nkbmanufacturing.com;

    # SSL Certificate directives (Managed by Certbot Let's Encrypt)
    # ssl_certificate /etc/letsencrypt/live/dcc.nkbmanufacturing.com/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/dcc.nkbmanufacturing.com/privkey.pem;

    client_max_body_size 100M;

    location / {
        proxy_pass http://127.0.0.1:4000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # WebSocket support for realtime logs & scanning notifications
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
    }
}
